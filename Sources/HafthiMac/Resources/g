#!/bin/sh
# Ghost Tasks: run non-interactive commands without writing over the shell prompt.
set -eu
umask 077

state=${HAFTHI_GHOST_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/hafthi/ghost-tasks}
mkdir -p "$state"

usage() {
    printf 'Ghost Tasks: g command [args...] | g jobs | g log ID | g follow ID | g clean\n'
    printf 'For a pipeline or shell expression, quote it: g '\''make && echo done'\''\n'
}

task_dir() {
    case ${1:-} in
        ghost[0-9]*)
            case ${1#ghost} in
                *[!0-9]*) printf 'Invalid Ghost Task ID\n' >&2; return 1 ;;
            esac
            ;;
        job.*)
            # Jobs from older Hafþi versions remain readable.
            case ${1#job.} in
                ''|*[!A-Za-z0-9]*) printf 'Invalid Ghost Task ID\n' >&2; return 1 ;;
            esac
            ;;
        *) printf 'Invalid Ghost Task ID\n' >&2; return 1 ;;
    esac
    [ -d "$state/$1" ] || { printf 'Unknown Ghost Task: %s\n' "$1" >&2; return 1; }
    printf '%s/%s\n' "$state" "$1"
}

next_task_dir() {
    # mkdir reserves the number atomically when several terminals start tasks at once.
    number=1
    while :; do
        candidate="$state/ghost$number"
        if mkdir "$candidate" 2>/dev/null; then
            printf '%s\n' "$candidate"
            return
        fi
        [ -e "$candidate" ] || { printf 'Cannot create Ghost Task in %s\n' "$state" >&2; return 1; }
        number=$((number + 1))
    done
}

start_in_drawer() {
    dir=$(next_task_dir)
    id=${dir##*/}
    printf '%s' "$*" > "$dir/command"
    : > "$dir/output"
    # Argument boundaries are preserved; only the PTY receives subsequent input.
    printf '%s\0' 'HAFTHI_GHOST_V2' "$PWD" "$PATH" "${HAFTHI_GHOST_SHELL:-${SHELL:-/bin/sh}}" "$@" > "$HAFTHI_GHOST_INBOX/$id.tmp"
    mv "$HAFTHI_GHOST_INBOX/$id.tmp" "$HAFTHI_GHOST_INBOX/$id"
    tries=0
    while [ ! -f "$dir/pid" ] && [ ! -f "$dir/exit" ] && [ "$tries" -lt 40 ]; do
        sleep 0.1
        tries=$((tries + 1))
    done
    if [ ! -f "$dir/pid" ] && [ ! -f "$dir/exit" ]; then
        rm -f "$HAFTHI_GHOST_INBOX/$id"
        printf 'Could not start %s in the Ghost Task drawer. Restart Hafþi and try again.\n' "$id" >&2
        printf '1\n' > "$dir/exit"
        return 1
    fi
    if [ -f "$dir/exit" ] && [ ! -f "$dir/pid" ]; then
        cat "$dir/output" >&2
        return 1
    fi
    printf 'Ghost Task %s started. Ctrl+G opens its drawer.\n' "$id"
}

status() {
    if [ -f "$1/exit" ]; then
        code=$(cat "$1/exit")
        if [ "$code" -eq 0 ]; then printf 'done'; else printf 'failed (%s)' "$code"; fi
    elif [ -f "$1/pid" ] && kill -0 "$(cat "$1/pid")" 2>/dev/null; then
        printf 'running'
    elif [ ! -f "$1/pid" ]; then
        printf 'starting'
    else
        printf 'stopped'
    fi
}

case ${1:-} in
    help|-h|--help|'') usage ;;
    jobs)
        found=0
        for dir in "$state"/ghost[0-9]* "$state"/job.*; do
            [ -d "$dir" ] || continue
            found=1
            printf '%s  %s  %s\n' "${dir##*/}" "$(status "$dir")" "$(cat "$dir/command")"
        done
        [ "$found" -eq 1 ] || printf 'No Ghost Tasks yet. Try: g sleep 5\n'
        ;;
    log|follow)
        action=$1
        dir=$(task_dir "${2:-}")
        if [ "$action" = follow ]; then tail -n 80 -f "$dir/output"; else cat "$dir/output"; fi
        ;;
    clean)
        for dir in "$state"/ghost[0-9]* "$state"/job.*; do
            [ -d "$dir" ] || continue
            [ -f "$dir/exit" ] && rm -r "$dir"
        done
        printf 'Removed completed Ghost Tasks.\n'
        ;;
    __run)
        dir=$(task_dir "${2:-}")
        shift 2
        workdir=$1
        shift
        printf '%s\n' "$$" > "$dir/pid"
        set +e
        (
            cd "$workdir" || exit 1
            if [ "$#" -eq 1 ]; then
                case $1 in
                    *' '*|*';'*|*'|'*|*'&'*)
                        if [ -x "$1" ]; then "$1"; else "${HAFTHI_GHOST_SHELL:-${SHELL:-/bin/sh}}" -lc "$1"; fi
                        ;;
                    *) "$1" ;;
                esac
            else
                "$@"
            fi
        ) > "$dir/output" 2>&1 < /dev/null
        code=$?
        printf '%s\n' "$code" > "$dir/exit.tmp"
        mv "$dir/exit.tmp" "$dir/exit"
        id=${dir##*/}
        if command -v notify-send >/dev/null 2>&1; then
            notify-send 'Ghost Tasks' "Task $id finished (exit $code)" >/dev/null 2>&1 || :
        elif [ "$(uname)" = Darwin ] && command -v osascript >/dev/null 2>&1; then
            osascript -e "display notification \"Task $id finished (exit $code)\" with title \"Ghost Tasks\"" >/dev/null 2>&1 || :
        fi
        ;;
    *)
        [ "$1" != -- ] || shift
        [ "$#" -gt 0 ] || { usage; exit 2; }
        # Every job gets its own PTY when the originating Hafþi window is available.
        # This lets a previously quiet command ask for input later.
        if [ -n "${HAFTHI_GHOST_INBOX:-}" ] && [ -d "$HAFTHI_GHOST_INBOX" ]; then
            start_in_drawer "$@"
            exit $?
        fi
        # Refuse obvious interactive programs before creating a job. Also catch
        # simple quoted commands such as g 'brew upgrade'.
        first=${1%% *}
        case ${first##*/} in
            brew|sudo|su|doas|pkexec)
                # Passwords and package selections need a real terminal.
                case $1 in
                    *' '*)
                        printf 'Write interactive arguments separately, e.g. g brew upgrade.\n' >&2
                        exit 2
                        ;;
                esac
                program=${first##*/}
                command -v "$program" >/dev/null 2>&1 || {
                    printf '%s is not installed.\n' "$program" >&2
                    exit 2
                }
                case $0 in
                    */*) app="${HAFTHI_BIN:-${0%/*}/../../MacOS/Hafthi}" ;;
                    *) app="${HAFTHI_BIN:-Hafthi}" ;;
                esac
                [ -x "$app" ] || {
                    printf 'Hafþi executable not found: %s\n' "$app" >&2
                    exit 2
                }
                nohup "$app" --interactive "$@" </dev/null >/dev/null 2>&1 &
                printf '%s opened in a separate Hafþi window for secure input.\n' "$program"
                exit 0
                ;;
            ssh|yay|paru|pacman|apt|apt-get|dnf|zypper|vim|nvim|nano|micro|yazi|less|top|htop)
                printf '%s needs an interactive terminal; run it normally.\n' "$first" >&2
                exit 2
                ;;
        esac

        # nohup alone leaves a controlling terminal attached. sudo and similar
        # programs can reopen /dev/tty even with stdin/stdout redirected.
        if command -v setsid >/dev/null 2>&1; then
            detach=$(command -v setsid)
        else
            case $0 in
                */*) detach="${0%/*}/g-detach" ;;
                *) detach=g-detach ;;
            esac
            [ -x "$detach" ] || {
                printf 'Ghost Tasks requires setsid or the bundled g-detach helper.\n' >&2
                exit 2
            }
        fi
        dir=$(next_task_dir)
        printf '%s' "$*" > "$dir/command"
        : > "$dir/output"
        # Do not inherit stdin or stdout from the interactive terminal.
        nohup "$detach" "$0" __run "${dir##*/}" "$PWD" "$@" </dev/null >/dev/null 2>&1 &
        printf 'Ghost Task %s started. Use g jobs or g log %s.\n' "${dir##*/}" "${dir##*/}"
        ;;
esac
